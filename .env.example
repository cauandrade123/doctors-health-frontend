# Copie para .env e ajuste. Tudo que começa com REACT_APP_ vai para o bundle público:
# nunca coloque aqui chaves secretas — elas pertencem ao backend.

# Endereço da API (use HTTPS em produção).
REACT_APP_API_URL=http://localhost:3000

# Chave do MapTiler (opcional). É pública: restrinja-a ao domínio do site no painel do MapTiler.
# Sem ela, o mapa usa o OpenStreetMap.
REACT_APP_MAPTILER_KEY=
